# =====================================================================
# AI Sales Agent - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit real secrets or API keys to repository.
# =====================================================================

# --- Gemini API Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- WhatsApp Cloud API Configuration ---
WHATSAPP_TOKEN=your_whatsapp_bearer_token_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
VERIFY_TOKEN=your_webhook_verify_token_here
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# --- Database Connection ---
DATABASE_URL=sqlite:///./sales_agent.db

# --- Image Search Services (Google Custom Search & Serper API) ---
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key_here
GOOGLE_CSE_ID=your_google_search_engine_id_here
SERPER_API_KEY=your_serper_api_key_here

# --- Application Public Domain / Base URL ---
BASE_URL=https://your-domain-or-ngrok.com

# --- OpenAI & Qdrant Hybrid Semantic Search Configuration ---
OPENAI_API_KEY=your_openai_api_key_here
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=parts_catalog

# --- Groq API Configuration (Whisper-Large-v3 STT) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Shadow Mode Testing Flag ---
# When ENABLE_SHADOW_MODE=true, vector matches are logged in background without altering primary responses
ENABLE_SHADOW_MODE=true
